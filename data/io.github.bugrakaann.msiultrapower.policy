<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- msi-ultrapower helper. Authorization is granted to this file only, not to python3 itself.
     The NVIDIA boot setting is done by this helper too, as part of a mode switch. -->
<policyconfig>
  <vendor>msi-ultrapower</vendor>
  <vendor_url>https://github.com/bugrakaann/msi-ultrapower</vendor_url>

  <action id="io.github.bugrakaann.msiultrapower.hardware">
    <description>Apply power mode hardware settings</description>
    <description xml:lang="tr">Güç modu donanım ayarlarını uygula</description>
    <description xml:lang="ru">Применить аппаратные настройки режима питания</description>
    <description xml:lang="es">Aplicar la configuración de hardware del modo de energía</description>
    <description xml:lang="ar">تطبيق إعدادات العتاد لوضع الطاقة</description>
    <message>Authentication is required to change fan, CPU, battery, device power and NVIDIA settings</message>
    <message xml:lang="tr">Fan, işlemci, pil, aygıt güç ve NVIDIA ayarlarını değiştirmek için kimlik doğrulama gerekiyor</message>
    <message xml:lang="ru">Для изменения настроек вентилятора, процессора, батареи, питания устройств и NVIDIA требуется аутентификация</message>
    <message xml:lang="es">Se requiere autenticación para cambiar la configuración del ventilador, la CPU, la batería, la energía de los dispositivos y NVIDIA</message>
    <message xml:lang="ar">المصادقة مطلوبة لتغيير إعدادات المروحة والمعالج والبطارية وطاقة الأجهزة وNVIDIA</message>
    <icon_name>battery</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/msi-ultrapower/msi-ultrapower-hardware</annotate>
  </action>
</policyconfig>
