# Maintainer: bugra <bugrakaan02@gmail.com>
#
# Depo kökünden:  make install   (ya da bu klasörde: makepkg -sci)
# Kaldırmak:      make uninstall (ya da: sudo pacman -R msi-ultrapower)

pkgname=msi-ultrapower
pkgver=3.0.0
pkgrel=1
pkgdesc="Power mode manager for MSI laptops on KDE Plasma (performance, balanced, battery)"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'power-profiles-daemon' 'libkscreen' 'polkit' 'initramfs' 'systemd')
makedepends=('gettext')
optdepends=('msi-ec-dkms-git: fan, EC mode, Cooler Boost and charge limit'
            'mcontrolcenter: set the fan curve for the manual-fan performance mode')
install=msi-ultrapower.install

# Kaynak kod bu deponun kendisi (iki üst klasör).
_repo="$startdir/../.."

package() {
    local site
    site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')

    # Python paketi → /usr/lib/python3.X/site-packages/msi_ultrapower
    install -d "$pkgdir$site"
    cp -r "$_repo/src/msi_ultrapower" "$pkgdir$site/"
    find "$pkgdir$site" -name __pycache__ -prune -exec rm -rf {} +
    python -m compileall -q -s "$pkgdir" -p / "$pkgdir$site/msi_ultrapower"

    install -Dm755 "$_repo/bin/msi-ultrapower"    "$pkgdir/usr/bin/msi-ultrapower"
    install -Dm755 "$_repo/bin/msi-ultrapower-ui" "$pkgdir/usr/bin/msi-ultrapower-ui"
    # Root yardımcıları: polkit eylemleri bu yollara bağlı (parola hatırlama).
    install -Dm755 "$_repo/bin/msi-ultrapower-hardware" "$pkgdir/usr/lib/msi-ultrapower/msi-ultrapower-hardware"
    install -Dm755 "$_repo/bin/msi-ultrapower-gpu-boot" "$pkgdir/usr/lib/msi-ultrapower/msi-ultrapower-gpu-boot"
    install -Dm644 "$_repo/data/io.github.bugrakaann.msiultrapower.policy" "$pkgdir/usr/share/polkit-1/actions/io.github.bugrakaann.msiultrapower.policy"
    install -Dm644 "$_repo/data/msi-ultrapower.desktop" "$pkgdir/usr/share/applications/msi-ultrapower.desktop"
    install -Dm644 "$_repo/data/msi-ultrapower-restore.service" "$pkgdir/usr/lib/systemd/system/msi-ultrapower-restore.service"
    install -Dm644 -t "$pkgdir/usr/share/doc/msi-ultrapower" "$_repo"/README*.md
    install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/msi-ultrapower/LICENSE"

    # Çeviriler: po/xx.po → /usr/share/locale/xx/LC_MESSAGES/msi-ultrapower.mo
    local po lang
    for po in "$_repo"/po/*.po; do
        [ -e "$po" ] || continue
        lang=$(basename "$po" .po)
        install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt --check -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/msi-ultrapower.mo" "$po"
    done
}
