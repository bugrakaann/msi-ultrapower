# Maintainer: bugra <bugrakaan02@gmail.com>
#
# Depo kökünden:  make install   (ya da bu klasörde: makepkg -sci)
# Kaldırmak:      make uninstall (ya da: sudo pacman -R pil-modu)

pkgname=pil-modu
pkgver=3.0.0
pkgrel=1
pkgdesc="MSI dizüstüleri / KDE için güç modu yöneticisi (performans, dengeli, batarya)"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'power-profiles-daemon' 'kscreen' 'polkit' 'initramfs' 'systemd')
makedepends=('gettext')
optdepends=('msi-ec-dkms-git: fan, EC modu, Cooler Boost ve şarj sınırı için'
            'mcontrolcenter: performans-manuel modunda fan eğrisini ayarlamak için')
install=pil-modu.install

# Kaynak kod bu deponun kendisi (iki üst klasör).
_repo="$startdir/../.."

package() {
    local site
    site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')

    # Python paketi → /usr/lib/python3.X/site-packages/pil_modu
    install -d "$pkgdir$site"
    cp -r "$_repo/src/pil_modu" "$pkgdir$site/"
    find "$pkgdir$site" -name __pycache__ -prune -exec rm -rf {} +
    python -m compileall -q -s "$pkgdir" -p / "$pkgdir$site/pil_modu"

    install -Dm755 "$_repo/bin/pil-modu"    "$pkgdir/usr/bin/pil-modu"
    install -Dm755 "$_repo/bin/pil-modu-ui" "$pkgdir/usr/bin/pil-modu-ui"
    # Root yardımcıları: polkit eylemleri bu yollara bağlı (parola hatırlama).
    install -Dm755 "$_repo/bin/pil-modu-hardware" "$pkgdir/usr/lib/pil-modu/pil-modu-hardware"
    install -Dm755 "$_repo/bin/pil-modu-gpu-boot" "$pkgdir/usr/lib/pil-modu/pil-modu-gpu-boot"
    install -Dm644 "$_repo/data/io.github.pilmodu.policy" "$pkgdir/usr/share/polkit-1/actions/io.github.pilmodu.policy"
    install -Dm644 "$_repo/data/pil-modu.desktop" "$pkgdir/usr/share/applications/pil-modu.desktop"
    install -Dm644 "$_repo/data/pil-modu-restore.service" "$pkgdir/usr/lib/systemd/system/pil-modu-restore.service"
    install -Dm644 "$_repo/README.md" "$pkgdir/usr/share/doc/pil-modu/README.md"
    install -Dm644 "$_repo/README.tr.md" "$pkgdir/usr/share/doc/pil-modu/README.tr.md"
    install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/pil-modu/LICENSE"

    # Çeviriler: po/xx.po → /usr/share/locale/xx/LC_MESSAGES/pil-modu.mo
    local po lang
    for po in "$_repo"/po/*.po; do
        [ -e "$po" ] || continue
        lang=$(basename "$po" .po)
        install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt --check -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/pil-modu.mo" "$po"
    done
}
