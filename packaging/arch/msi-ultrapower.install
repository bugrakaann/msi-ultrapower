# pacman install / upgrade / remove hooks (run as root).

post_install() {
    # If a mode was chosen before, keep restoring its settings at boot.
    if [ -e /var/lib/msi-ultrapower/hardware.json ] || [ -e /var/lib/msi-ultrapower/charge ]; then
        systemctl enable msi-ultrapower-restore.service >/dev/null 2>&1 || true
    fi
    echo "msi-ultrapower installed. App menu: Power Modes · Terminal: msi-ultrapower --help"
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable msi-ultrapower-restore.service >/dev/null 2>&1 || true
    # Remove the NVIDIA block left by a battery mode, so the GPU is not locked after removal.
    /usr/lib/msi-ultrapower/msi-ultrapower-gpu-boot hybrid || true
}

post_remove() {
    rm -rf /var/lib/msi-ultrapower
    # The password-free polkit rule (only if it is ours).
    if grep -qs "Managed by msi-ultrapower" /etc/polkit-1/rules.d/49-msi-ultrapower.rules; then
        rm -f /etc/polkit-1/rules.d/49-msi-ultrapower.rules
    fi
    echo "Your personal data is kept in ~/.local/share/msi-ultrapower and ~/.config/msi-ultrapower; delete them if you like."
}
