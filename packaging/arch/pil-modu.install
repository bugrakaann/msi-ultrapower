# pacman kurulum / güncelleme / kaldırma kancaları (root olarak çalışır).

_remove_legacy_install() {
    # 2.0 öncesi elle kurulumun kalıntıları: /etc'deki servis, paketin /usr/lib'deki servisini gölgeler.
    if grep -qs /usr/local/lib/pil-modu /etc/systemd/system/pil-modu-restore.service; then
        systemctl disable pil-modu-restore.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/pil-modu-restore.service
        rm -rf /usr/local/lib/pil-modu
        systemctl daemon-reload
    fi
}

post_install() {
    _remove_legacy_install
    # Daha önce bir mod seçildiyse ayarlar açılışta geri yüklenmeye devam etsin.
    if [ -e /var/lib/pil-modu/hardware.json ] || [ -e /var/lib/pil-modu/charge ]; then
        systemctl enable pil-modu-restore.service >/dev/null 2>&1 || true
    fi
    echo "pil-modu installed. App menu: Power Modes · Terminal: pil-modu --help"
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable pil-modu-restore.service >/dev/null 2>&1 || true
    # Batarya modundan kalan NVIDIA engelini kaldır; paket gidince GPU kilitli kalmasın.
    /usr/lib/pil-modu/pil-modu-gpu-boot hybrid || true
}

post_remove() {
    rm -rf /var/lib/pil-modu
    # Otomatik mod için yazılan parolasız kural (yalnızca bizimkiyse).
    if grep -qs "Managed by pil-modu" /etc/polkit-1/rules.d/49-pil-modu.rules; then
        rm -f /etc/polkit-1/rules.d/49-pil-modu.rules
    fi
    echo "Your personal data is kept in ~/.local/share/pil-modu and ~/.config/pil-modu; delete them if you like."
}
