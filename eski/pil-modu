#!/usr/bin/python3
"""MSI GF65 / KDE: performans, dengeli, batarya ve geri dönüş."""
import argparse, fcntl, importlib.util, json, select, subprocess, sys, time
from pathlib import Path
ROOT=Path.home()/'.local/share/pil-modu'
STATE=ROOT/'original-v2.json'
ACTIVE=ROOT/'active.json'
spec=importlib.util.spec_from_file_location('hardware',ROOT/'hardware.py')
hw=importlib.util.module_from_spec(spec); spec.loader.exec_module(hw)
PRESETS={
 'performans':dict(profile='performance',hz=120,brightness=100,shift='turbo',boost='on',turbo='0',gpu='on'),
 'performans-manuel':dict(profile='performance',hz=120,brightness=100,shift='turbo',boost='off',turbo='0',gpu='on',fan='advanced'),
 'dengeli':dict(profile='balanced',hz=120,brightness=60,shift='comfort',boost='off',turbo='0',gpu='auto'),
 'batarya':dict(profile='power-saver',hz=120,brightness=30,shift='eco',boost='off',turbo='1',gpu='auto')}
PRESETS['batarya-48']=dict(PRESETS['batarya'],panel_hz=48)
BATTERY_MODES=('batarya','batarya-48')
def run(*args):
 p=subprocess.run(args,capture_output=True,text=True,timeout=30)
 if p.returncode or 'applying config failed' in (p.stdout+p.stderr).lower(): raise RuntimeError(' '.join(args[:2])+': '+p.stderr.strip()+p.stdout.strip())
 return p.stdout.strip()
def save(path,obj):
 temp=path.with_suffix('.tmp'); temp.write_text(json.dumps(obj,indent=2,ensure_ascii=False)); temp.chmod(0o600); temp.replace(path)
def capture():
 return dict(profile=run('powerprofilesctl','get'),outputs=json.loads(run('kscreen-doctor','-j'))['outputs'],hardware=hw.read_state())
def mode_for(output,previous=None,hz=None):
 source=previous or output
 old=next((m for m in source['modes'] if m['id']==source['currentModeId']),None)
 if old is None: old=next((m for m in source['modes'] if m['id'] in source.get('preferredModes',[])),source['modes'][0])
 wanted=hz if hz is not None else old['refreshRate']
 modes=[m for m in output['modes'] if m['size']==old['size']]
 if not modes: raise RuntimeError(output['name']+': eski çözünürlük bulunamadı')
 result=min(modes,key=lambda m:abs(m['refreshRate']-wanted))
 if abs(result['refreshRate']-wanted)>1: raise RuntimeError(output['name']+f': {wanted} Hz desteklenmiyor')
 return result['id']
def screen_plan(current,original,preset=None,external='otomatik'):
 old={o['name']:o for o in original}; args=[]; count=0; x=0
 if preset and not any(o['connected'] and o['name'].startswith('eDP') for o in current): raise RuntimeError('Dahili ekran bulunamadı')
 for o in sorted(current,key=lambda o:not o['name'].startswith('eDP')):
  if not o['connected']: continue
  prev=old.get(o['name'],o); internal=o['name'].startswith('eDP'); enabled=prev['enabled']
  if preset: enabled=internal or external=='koru' or (external=='otomatik' and preset['profile']!='power-saver')
  prefix='output.'+o['name']+'.'; args.append(prefix+('enable' if enabled else 'disable'))
  if not enabled: continue
  count+=1; mid=mode_for(o,prev,(preset.get('panel_hz',preset['hz']) if internal else preset['hz']) if preset else None)
  args.extend([prefix+'mode.'+mid,prefix+'scale.'+str(prev['scale'])])
  if preset:
   args.append(prefix+f'position.{x},0')
   mode=next(m for m in o['modes'] if m['id']==mid); x+=round(mode['size']['width']/prev['scale'])
  else: args.append(prefix+f"position.{prev['pos']['x']},{prev['pos']['y']}")
  args.append(prefix+'priority.'+str(count if preset else prev.get('priority',count)))
  if internal: args.append(prefix+'brightness.'+str(preset['brightness'] if preset else round(prev['brightness']*100)))
 if not count: raise RuntimeError('En az bir bağlı ekran açık kalmalı')
 return args
def hardware_plan(original,preset):
 result=dict(original)
 result.update({hw.EC+'shift_mode':preset['shift'],hw.EC+'fan_mode':preset.get('fan','auto'),hw.EC+'cooler_boost':preset['boost'],hw.CPU+'no_turbo':preset['turbo']})
 for i in range(4):
  path=hw.GPU+str(i)+'/power/control'
  if Path(path).exists(): result[path]=preset['gpu'] if i==0 else 'auto'
  else: result.pop(path,None)
 if preset['profile']=='power-saver' and hw.LED in result: result[hw.LED]='0'
 return result
def status():
 c=capture()
 print('Seçilen mod:',json.loads(ACTIVE.read_text()) if ACTIVE.exists() else 'henüz seçilmedi')
 print('Gerçek güç profili:',c['profile'])
 for o in c['outputs']:
  if o['connected']:
   m=next((m for m in o['modes'] if m['id']==o['currentModeId']),{})
   print(o['name'],'açık' if o['enabled'] else 'kapalı',m.get('name',''), 'parlaklık',o.get('brightness'))
 for p,v in c['hardware'].items(): print(p.removeprefix('/sys/'),'=',v)
 gpu_path=Path(hw.GPU+'0/power/runtime_status')
 print('NVIDIA gerçek durumu:',gpu_path.read_text().strip() if gpu_path.exists() else 'PCI aygıtı yok / devre dışı')
 print('NVIDIA sonraki açılış:', 'devre dışı' if Path('/etc/modprobe.d/90-pil-modu-nvidia.conf').exists() else 'kullanılabilir')
 for b in Path('/sys/class/power_supply').glob('BAT*'):
  print('Pil:',(b/'status').read_text().strip(),(b/'capacity').read_text().strip()+'%')
  if (b/'current_now').exists(): print('Pil deşarj gücü:' if (b/'status').read_text().strip()=='Discharging' else 'Pil şarj/akım gücü (sistem tüketimi değil):',round(int((b/'voltage_now').read_text())*int((b/'current_now').read_text())/1e12,2),'W')
def main():
 p=argparse.ArgumentParser(description=__doc__)
 p.add_argument('mod',choices=[*PRESETS,'geri','normal','durum'])
 p.add_argument('--harici',choices=['otomatik','koru','kapat'],default='otomatik',help='Bataryada varsayılan kapalı, diğer modlarda açık')
 p.add_argument('--dene',action='store_true',help='Ayar değiştirmeden planı göster')
 opt=p.parse_args(); ROOT.mkdir(parents=True,exist_ok=True)
 with (ROOT/'lock').open('w') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  if opt.mod=='durum': status(); return
  if opt.mod in BATTERY_MODES and opt.harici=='koru': raise RuntimeError('Tam batarya modu NVIDIA ve HDMI çıkışını devre dışı bırakır. Çift ekran için dengeli modunu seç.')
  before=capture(); restoring=opt.mod in ('geri','normal')
  if restoring and not STATE.exists(): print('Geri dönüş kaydı yok; ayar değiştirilmedi.'); return
  original=json.loads(STATE.read_text()) if STATE.exists() else before
  preset=None if restoring else PRESETS[opt.mod]
  target_hw=hw.writable(original['hardware']) if restoring else hardware_plan(original['hardware'],preset)
  target_hw={k:v for k,v in target_hw.items() if not k.startswith(hw.GPU) or Path(k).exists()}
  hw.validate(target_hw)
  target_profile=original['profile'] if restoring else preset['profile']
  args=screen_plan(before['outputs'],original['outputs'],preset,opt.harici)
  rollback_args=screen_plan(before['outputs'],before['outputs'])
  if opt.dene:
   print('Sonraki açılış GPU modu:', 'integrated' if opt.mod in BATTERY_MODES else 'hybrid')
   print('Profil:',target_profile); print('kscreen-doctor',*args); print(json.dumps(target_hw,indent=2)); return
  if original['hardware'].get(hw.EC+'shift_mode')=='unspecified': print('Not: Eski EC unspecified değeri yazılamaz; geri dönüşte comfort kullanılır.',flush=True)
  if not STATE.exists(): save(STATE,original)
  helper=subprocess.Popen(['pkexec','/usr/bin/python3',str(ROOT/'hardware.py'),json.dumps(target_hw)],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
  kde_started=False
  try:
   readable,_,_=select.select([helper.stdout],[],[],120)
   if not readable or helper.stdout.readline().strip()!='READY':
    if helper.poll() is None: helper.terminate()
    raise RuntimeError('Donanım yetkilendirmesi/uygulaması başarısız: '+helper.communicate(timeout=10)[1])
   kde_started=True
   run('powerprofilesctl','set',target_profile); run('kscreen-doctor',*args)
   time.sleep(2)
   actual=capture()
   if actual['profile']!=target_profile: raise RuntimeError('Güç profili başka bir uygulama tarafından değiştirildi')
   for path,value in target_hw.items():
    if actual['hardware'].get(path)!=value: raise RuntimeError('Donanım ayarı değişti: '+path)
   for arg in args:
    _,name,setting,*value=arg.split('.')
    output=next(o for o in actual['outputs'] if o['name']==name)
    if setting in ('enable','disable') and output['enabled']!=(setting=='enable'): raise RuntimeError('Ekran durumu doğrulanamadı: '+name)
    if setting=='mode':
     previous=next(o for o in before['outputs'] if o['name']==name)
     expected=next(m for m in previous['modes'] if m['id']=='.'.join(value))
     observed=next(m for m in output['modes'] if m['id']==output['currentModeId'])
     if expected['size']!=observed['size'] or abs(expected['refreshRate']-observed['refreshRate'])>1:
      raise RuntimeError('Ekran frekansı doğrulanamadı: '+name+' '+str(observed))
    if setting=='brightness' and abs(output['brightness']*100-float('.'.join(value)))>2:
     raise RuntimeError('Parlaklık doğrulanamadı: '+name)
   helper.stdin.write('COMMIT\n'); helper.stdin.flush()
   _,err=helper.communicate(timeout=10)
   if helper.returncode: raise RuntimeError(err)
  except BaseException:
   if kde_started:
    for command in [('powerprofilesctl','set',before['profile']),('kscreen-doctor',*rollback_args)]:
     try: run(*command)
     except Exception as exc: print('Geri alma hatası:',exc,file=sys.stderr)
   if helper.poll() is None: helper.communicate(input='ROLLBACK\n',timeout=15)
   raise
  if restoring: STATE.unlink(); ACTIVE.unlink(missing_ok=True)
  else: save(ACTIVE,{'mod':opt.mod,'harici':opt.harici})
  with (ROOT/'history.log').open('a') as log: log.write(time.strftime('%Y-%m-%d %H:%M:%S ')+opt.mod+' '+opt.harici+'\n')
  print('CPU, ekran ve EC ayarları uygulandı:',opt.mod,flush=True)
  boot_mode='integrated' if opt.mod in BATTERY_MODES else 'hybrid'
  gpu_result=subprocess.run(['pkexec','/usr/bin/python3',str(ROOT/'gpu_boot.py'),boot_mode])
  if gpu_result.returncode:
   raise RuntimeError('CPU/ekran profili uygulandı, ancak GPU açılış tercihi tamamlanamadı. Aynı modu yeniden çalıştır.')
  gpu_present=Path(hw.GPU+'0').exists()
  if boot_mode=='integrated' and gpu_present:
   print('NVIDIA henüz devre dışı değil. Tam batarya modu için yeniden başlatman gerekiyor.',flush=True)
  elif boot_mode=='hybrid' and not gpu_present:
   print('NVIDIA şu anda devre dışı. Tekrar kullanmak için yeniden başlatman gerekiyor.',flush=True)
  else: print('GPU durumu seçilen modla uyumlu.',flush=True)
  print('Durum: pil-modu durum | Geri dönüş: pil-modu geri')
if __name__=='__main__':
 try: main()
 except Exception as exc: print('HATA:',exc,file=sys.stderr); sys.exit(1)
