#!/usr/bin/python3
"""KDE güç modu arayüzü; donanım işlemleri pil-modu tarafından yürütülür."""
import json
import sys
from pathlib import Path
from PySide6.QtCore import QProcess, QTimer
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QComboBox, QPlainTextEdit, QMessageBox)
ROOT=Path.home()/'.local/share/pil-modu'
SCRIPT=Path.home()/'.local/bin/pil-modu'
NAMES={'performans':'Maksimum performans','performans-manuel':'Maksimum performans · Manuel fan','dengeli':'Dengeli','batarya':'Maksimum batarya','batarya-48':'Maksimum batarya · 48 Hz'}

def read(path):
    try: return Path(path).read_text().strip()
    except OSError: return '—'

def consumption(battery=Path('/sys/class/power_supply/BAT1')):
    status=read(battery/'status')
    if status=='Charging':
        return 'Şarj oluyor · Toplam tüketim pilden ölçülemiyor'
    if status in ('Full','Not charging'):
        return 'Pil boşalmıyor · Toplam tüketim pilden ölçülemiyor'
    if status!='Discharging':
        return 'Anlık tüketim: — · Pil verisi alınamadı'
    try:
        if (battery/'power_now').exists():
            watts=abs(int(read(battery/'power_now')))/1e6
        else:
            watts=abs(int(read(battery/'voltage_now'))*int(read(battery/'current_now')))/1e12
        if read(battery/'status')!='Discharging':
            return 'Güç kaynağı değişiyor…'
        return f'Anlık tüketim: {watts:.2f} W · Pilden ölçülen toplam güç'
    except (ValueError,OSError):
        return 'Anlık tüketim: — · Güç verisi alınamadı'

class Window(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle('Güç Modları')
        self.setWindowIcon(QIcon.fromTheme('battery'))
        self.resize(570, 530)
        self.busy=False
        layout=QVBoxLayout(self)
        layout.setContentsMargins(24,24,24,24)
        layout.setSpacing(14)
        title=QLabel('Güç Modları')
        title.setStyleSheet('font-size: 24px; font-weight: 600;')
        layout.addWidget(title)
        hint=QLabel('Maksimum batarya · 48 Hz modunda dahili ekran 48 Hz, diğer modlarda 120 Hz. Bir moda tıklayarak uygula.')
        hint.setWordWrap(True)
        layout.addWidget(hint)
        self.status=QLabel()
        self.status.setWordWrap(True)
        self.status.setStyleSheet('padding: 12px; background: palette(alternate-base); border-radius: 8px;')
        layout.addWidget(self.status)
        self.consumption=QLabel()
        self.consumption.setWordWrap(True)
        self.consumption.setStyleSheet('font-size: 16px; font-weight: 600;')
        self.consumption.setToolTip('2 saniyede bir yenilenir. Sensörün bildirdiği pil deşarj gücüdür; priz tüketimini ölçmez.')
        layout.addWidget(self.consumption)
        row=QHBoxLayout()
        row.addWidget(QLabel('Harici ekran'))
        self.external=QComboBox()
        for label,data in [('Moda göre otomatik','otomatik'),('Açık tut','koru'),('Kapat','kapat')]:
            self.external.addItem(label,data)
        try:
            saved=json.loads((ROOT/'active.json').read_text())
            self.external.setCurrentIndex(max(0,self.external.findData(saved.get('harici','otomatik'))))
        except (OSError,ValueError): pass
        row.addWidget(self.external,1)
        layout.addLayout(row)
        self.buttons=[]
        for mode,desc in [('performans','%100 parlaklık · Turbo açık · Cooler Boost'),
                          ('performans-manuel','%100 parlaklık · Turbo açık · Fan eğrisi senin kontrolünde'),
                          ('dengeli','%60 parlaklık · Turbo açık · Otomatik fan'),
                          ('batarya','120 Hz · %30 parlaklık · Eco · NVIDIA kapalı (yeniden başlatma)'),
                          ('batarya-48','48 Hz · %30 parlaklık · Eco · NVIDIA kapalı (yeniden başlatma)')]:
            button=QPushButton(NAMES[mode]+'\n'+desc)
            button.setMinimumHeight(60)
            button.clicked.connect(lambda checked=False,m=mode:self.apply(m))
            layout.addWidget(button)
            self.buttons.append(button)
        self.restore=QPushButton('Önceki ayarlara dön')
        self.restore.clicked.connect(lambda:self.apply('geri'))
        layout.addWidget(self.restore)
        note=QLabel('Her iki maksimum batarya modu NVIDIA ve HDMI’yi kapatır. GPU değişimi yeniden başlatma gerektirir.\nDonanım ayarları için yönetici parolası istenebilir.')
        note.setWordWrap(True)
        layout.addWidget(note)
        self.progress=QLabel('Hazır')
        layout.addWidget(self.progress)
        self.log=QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(200)
        self.log.setMaximumHeight(120)
        self.log.setPlaceholderText('İşlem sonucu burada görünür.')
        layout.addWidget(self.log)
        self.process=QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.output)
        self.process.finished.connect(self.finished)
        self.process.errorOccurred.connect(self.error)
        self.timer=QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)
        self.refresh()

    def refresh(self):
        self.consumption.setText(consumption())
        try: name=NAMES.get(json.loads((ROOT/'active.json').read_text()).get('mod'),'Önceki ayarlar')
        except (OSError,ValueError): name='Özel / önceki ayarlar'
        gpu=read('/sys/bus/pci/devices/0000:01:00.0/power/runtime_status')
        gpu={'suspended':'Uykuda','active':'Aktif','suspending':'Uykuya geçiyor','resuming':'Uyanıyor'}.get(gpu,gpu)
        disabled=not Path('/sys/bus/pci/devices/0000:01:00.0').exists()
        if disabled: gpu='Devre dışı (PCI aygıtı yok)'
        next_disabled=Path('/etc/modprobe.d/90-pil-modu-nvidia.conf').exists()
        pending='\nYeniden başlatınca: '+('NVIDIA devre dışı' if next_disabled else 'NVIDIA kullanılabilir') if next_disabled!=disabled else ''
        ec=read('/sys/devices/platform/msi-ec/shift_mode')
        turbo=read('/sys/devices/system/cpu/intel_pstate/no_turbo')
        turbo={'0':'açık','1':'kapalı'}.get(turbo,turbo)
        self.status.setText(f'Son seçilen: {name}\nNVIDIA: {gpu}  ·  EC: {ec}  ·  CPU turbo: {turbo}{pending}')
        self.restore.setEnabled(not self.busy and (ROOT/'original-v2.json').exists())

    def apply(self,mode):
        if self.busy: return
        self.busy=True
        self.log.clear()
        self.progress.setText('Uygulanıyor… Parola penceresi açılabilir.')
        for b in self.buttons: b.setEnabled(False)
        self.external.setEnabled(False)
        self.restore.setEnabled(False)
        args=[mode]
        if mode!='geri': args+=['--harici','kapat' if mode in ('batarya','batarya-48') else self.external.currentData()]
        self.process.start(str(SCRIPT),args)

    def output(self):
        data=bytes(self.process.readAllStandardOutput()).decode('utf-8',errors='replace')
        if data: self.log.appendPlainText(data.rstrip())

    def finished(self,code,exit_status):
        self.output()
        self.busy=False
        for b in self.buttons: b.setEnabled(True)
        self.external.setEnabled(True)
        self.progress.setText('İşlem tamamlandı; GPU geçişi için yeniden başlatma gerekebilir.' if code==0 and exit_status==QProcess.NormalExit else 'İşlem tamamlanamadı. Ayrıntılar aşağıda.')
        self.refresh()

    def error(self,error):
        if error==QProcess.FailedToStart:
            self.log.appendPlainText(self.process.errorString())
            self.finished(1,QProcess.CrashExit)

    def closeEvent(self,event):
        if self.busy:
            QMessageBox.information(self,'İşlem sürüyor','Ayarların uygulanması veya geri alınması bitince pencereyi kapatabilirsin.')
            event.ignore()
        else: event.accept()

if __name__=='__main__':
    app=QApplication(sys.argv)
    app.setApplicationName('Güç Modları')
    window=Window()
    window.show()
    sys.exit(app.exec())
